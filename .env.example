# Base URL under test
BASE_URL=https://find-and-update.company-information.service.gov.uk

# Run with a visible browser (default: headless)
HEADLESS=false

# Slow every interaction down by N ms, useful when watching a run
SLOW_MO=250

# chromium | firefox | webkit
BROWSER=chromium

# Per-action timeout in ms
TIMEOUT=30000

# Record a Playwright trace for failing scenarios (reports/traces/*.zip)
TRACE=true
